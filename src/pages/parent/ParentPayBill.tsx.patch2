{/* Error Details Modal */}
<ErrorDetailsModal
  isOpen={showErrorModal}
  payment={selectedFailedPayment}
  errorType={paymentErrorType}
  user={user}
  onRetry={() => {
    setShowErrorModal(false);
    const assignment = assignments.find(a => 
      a.id === selectedFailedPayment?.assignment_id || 
      a.id === selectedFailedPayment?.metadata?.assignment_id
    );
    if (assignment) {
      setSelectedFailedPayment(null);
      handlePayNow(assignment);
    } else {
      toast.error('Payment record not found. Please refresh and try again.');
      setSelectedFailedPayment(null);
      refreshData();
    }
  }}
  onClose={() => {
    setShowErrorModal(false);
    setSelectedFailedPayment(null);
    // Refresh data to update the fee list
    refreshData();
  }}
  formatCurrency={formatCurrency}
/>

{/* Failure Modal */}
<FailureModal
  isOpen={showFailure}
  reason={failureReason}
  details={failureDetails}
  onRetry={() => {
    setShowFailure(false);
    setFailureReason('');
    setFailureDetails('');
    if (selectedAssignment) {
      setShowPaymentModal(true);
    } else {
      // If no assignment selected, refresh and stay on page
      refreshData();
    }
  }}
  onClose={() => {
    setShowFailure(false);
    setFailureReason('');
    setFailureDetails('');
    // Refresh data to update the fee list
    refreshData();
  }}
/>
// Add this useEffect after the fetchPayments definition

  // Watch for payment status changes
  useEffect(() => {
    if (selectedChild?.id) {
      // Refresh payments when the component mounts or child changes
      fetchPayments(selectedChild.id);
    }
  }, [selectedChild?.id]);
